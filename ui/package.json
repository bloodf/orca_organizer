{
  "name": "orca-organizer-ui",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "Vue 3 + PrimeVue panel of the Organizer plugin. Built into one offline HTML file and embedded in ../shape_arrange.py.",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vue-tsc --noEmit && vite build && node scripts/embed.mjs",
    "check:embedded": "vite build && node scripts/embed.mjs --check",
    "check:shared": "node shared/scripts/check.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "primevue": "4.5.5",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
