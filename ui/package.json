{
  "name": "orca-organizer-ui",
  "version": "0.16.3",
  "private": true,
  "type": "module",
  "description": "Vue 3 + PrimeVue panel of the Organizer plugin. Built into one offline HTML file and embedded in ../shape_arrange.py.",
  "scripts": {
    "typecheck": "node node_modules/@orca-plugins/ui-foundation/scripts/vue-tsc.mjs --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node node_modules/@orca-plugins/ui-foundation/scripts/vue-tsc.mjs --noEmit && vite build && node scripts/embed.mjs",
    "check:embedded": "vite build && node scripts/embed.mjs --check"
  },
  "dependencies": {
    "@orca-plugins/ui-foundation": "github:bloodf/orca-ui-foundation#v5.10.0",
    "@primeuix/themes": "3.1.1",
    "primevue": "5.0.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  }
}
